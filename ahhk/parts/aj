    r.setProperty("--accent2", `hsl(${hue2}, 55%, 35%)`);
    r.setProperty("--card-bg", "rgba(255,255,255,.5)");
    r.setProperty("--card-line", "rgba(0,0,0,.12)");
  }
  const pair = FONTS[Math.floor(Math.random()*FONTS.length)];
  loadFonts(pair);
  r.setProperty("--font-display", pair[0]);
  r.setProperty("--font-body", pair[1]);
  if(!firstRoll && !charBusy && sleepState===0){
    setChar(FACE.happy, "hop");
    charSay(Math.random()<.5 ? "Ooh — new look." : "Fresh coat of paint. Learned a little more about your taste.", 3500);
    setTimeout(()=>{ if(!charBusy && sleepState===0) setChar(FACE.idle,""); }, 2500);
  }
  firstRoll = false;
  if(typeof applyCustom === "function") applyCustom(); // keep the bot's glow synced to the new theme
  return {layout: LAYOUTS[Math.floor(Math.random()*LAYOUTS.length)]};
}
