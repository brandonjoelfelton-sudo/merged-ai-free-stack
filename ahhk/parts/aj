/* chat: thinking face + permanent chat memory + name learning */
async function send(ctx){
  const input = document.getElementById(ctx+"-input");
  const text = input.value.trim(); if(!text) return;
  input.value = ""; lastActivity = Date.now();
  addMsg(ctx, "you", text);
  const thinking = addMsg(ctx, "muse", `<span class="typing">●●●</span>`);
  charBusy = true; setChar(FACE.think, "think"); charSay("💭 thinking…", 0);
  const nm = text.match(/(?:call me|my name is)\s+([A-Za-z]{2,20})/i);
  if(nm){ MEM.name = nm[1][0].toUpperCase()+nm[1].slice(1); saveMem(); }
  history.push({role:"user", content:text});
  let reply;
  if(brainOnline){
    try{
      const r = await fetch("http://localhost:11434/api/chat", {
        method:"POST", headers:{"Content-Type":"application/json"},
        body: JSON.stringify({model:"llama3.1:8b", stream:false,
          messages:[{role:"system", content:SYSTEM}, ...history.slice(-10)]})
      });
      const j = await r.json();
      reply = j.message && j.message.content;
    }catch(e){ brainOnline=false; }
  }
  if(!reply){
    reply = FALLBACK[Math.floor(Math.random()*FALLBACK.length)];
    if(nm) reply = `Locked in, ${MEM.name} — I'll remember that forever. ` + reply;
    else if(MEM.name && Math.random()<.3) reply = MEM.name + ", " + reply[0].toLowerCase() + reply.slice(1);
  }else if(nm && !new RegExp(MEM.name,"i").test(reply)){
    reply = `Got it, ${MEM.name} — stored in permanent memory.\n\n` + reply;
  }
  history.push({role:"assistant", content:reply});
  MEM.chat.push({t:Date.now(), you:text, ahhk:reply}); saveMem();
  if(thinking) thinking.innerHTML = `<span class="who">Ahhk</span>${reply.replace(/</g,"&lt;").replace(/\n/g,"<br>")}`;
  bubEl.classList.remove("show"); charBusy = false;
  if(sleepState===0){ setChar(FACE.happy, "hop"); setTimeout(()=>{ if(!charBusy && sleepState===0) setChar(FACE.idle,""); }, 2200); }
}
