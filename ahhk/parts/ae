const MEM_KEY = "ahhk_brain_v1";
function blankMem(){ return {v:1, firstSeen:Date.now(), lastSeen:null, visits:0,
  dwell:{}, favQuotes:[], chat:[], name:null, themeRolls:0, lastHue:null, avatar:null, avatarLib:[], custom:null}; }
let MEM;
try{ MEM = JSON.parse(localStorage.getItem(MEM_KEY)) || blankMem(); }
catch(e){ MEM = blankMem(); }
function saveMem(){
  try{ localStorage.setItem(MEM_KEY, JSON.stringify(MEM)); }
  catch(e){ // storage full → keep everything, trim only oldest chat half
    MEM.chat = MEM.chat.slice(Math.ceil(MEM.chat.length/2));
    try{ localStorage.setItem(MEM_KEY, JSON.stringify(MEM)); }catch(e2){}
  }
}
MEM.visits++; MEM.lastSeen = Date.now(); saveMem();
setInterval(()=>{ MEM.lastSeen = Date.now(); saveMem(); }, 30000);
function memCount(){ return MEM.favQuotes.length + MEM.chat.length + (MEM.name?1:0) + MEM.visits; }
/* dwell-based theme learning */
let hueStart = Date.now();
function recordDwell(){
  if(MEM.lastHue === null) return;
  const sec = Math.round((Date.now() - hueStart)/1000);
  MEM.dwell[MEM.lastHue] = (MEM.dwell[MEM.lastHue]||0) + sec;
  hueStart = Date.now();
}
function learnedHue(){
  recordDwell();
  const keys = Object.keys(MEM.dwell);
  if(keys.length && Math.random() < .55){ // 55%: bias toward hues you lingered on
    const top = keys.sort((a,b)=>MEM.dwell[b]-MEM.dwell[a])[0];
    return (parseInt(top) + Math.floor(Math.random()*50) - 25 + 360) % 360;
  }
  return Math.floor(Math.random()*360);
}
window.addEventListener("beforeunload", ()=>{ recordDwell(); saveMem(); });

