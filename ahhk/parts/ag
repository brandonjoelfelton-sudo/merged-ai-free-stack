function avBlend(hex, other, amount){
  const ok = /^#[0-9a-fA-F]{6}$/;
  if(!ok.test(hex) || !ok.test(other)) return hex;
  const A=[1,3,5].map(i=>parseInt(hex.slice(i,i+2),16)), B=[1,3,5].map(i=>parseInt(other.slice(i,i+2),16));
  return "#" + A.map((v,i)=>Math.round(v*(1-amount)+B[i]*amount).toString(16).padStart(2,"0")).join("");
}
function validAvatar(input){
