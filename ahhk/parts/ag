  for(const k in enums){ if(typeof input[k]==="string" && enums[k].some(o=>o[0]===input[k])) copy[k]=input[k]; }
  if(typeof input.finish==="string" && ["glossy","matte","metallic"].includes(input.finish)) copy.finish=input.finish;
  for(const k of ["shellColor","accentColor","visorColor"]){
    if(typeof input[k]==="string" && /^#[0-9a-fA-F]{6}$/.test(input[k])) copy[k]=input[k];
  }
  for(const k of ["eyeSize","headSize"]){
    if(typeof input[k]==="number" && isFinite(input[k])) copy[k]=Math.max(75, Math.min(125, input[k]));
  }
  if(typeof input.name==="string" && input.name.trim()) copy.name = input.name.slice(0,48);
  return copy;
}

