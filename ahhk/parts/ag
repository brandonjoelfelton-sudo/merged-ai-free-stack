const photoA = document.getElementById("photoA"), photoB = document.getElementById("photoB");
let photoFront = null, curVibe = "nature", curPhotoId = null;
function unsplashURL(id){ return `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=1600&q=70`; }
function applyPhoto(layer, url){
  layer.style.backgroundImage = `url("${url}")`;
  layer.classList.add("on");
  const other = (layer === photoA) ? photoB : photoA;
  other.classList.remove("on");
  photoFront = layer;
}
function crossfadePhoto(id){
  curPhotoId = id;
  const back = (photoFront === photoA) ? photoB : photoA;
  const img = new Image();
  img.onload = ()=> applyPhoto(back, unsplashURL(id));
  img.onerror = ()=>{ // any dead link → guaranteed-live fallback photo
    const fb = `https://picsum.photos/seed/ahhk-${id}/1600/900`;
    const im2 = new Image();
    im2.onload = ()=> applyPhoto(back, fb);
    im2.src = fb;
  };
  img.src = unsplashURL(id);
}
