ry-grid">${cards}</div>` : `<p class="avs-hint">Nothing saved yet. Hit "Save character" up top to bank this build.</p>`}</div>`;
}
function studioPreview(){ const s = document.getElementById("avs-stage"); if(s) s.innerHTML = avatarSVG(MEM.avatar, null, null); }
function avPatch(key, value){
  if(key==="eyeSize"||key==="headSize") value = +value;
  MEM.avatar = validAvatar(Object.assign({}, MEM.avatar, {[key]:value}));
  saveMem(); renderChar("idle"); studioPreview();
  const opt = document.getElementById("avs-options");
  if(!opt) return;
  if(key==="eyeSize"||key==="headSize"){
    const inp = opt.querySelector(`input[data-k="${key}"]`);
    const h3 = inp && inp.closest(".avs-section") && inp.closest(".avs-section").querySelector("h3 b");
    if(h3) h3.textContent = value + "%";
  }else if(key!=="shellColor" && key!=="accentColor" && key!=="visorColor"){
    opt.innerHTML = studioOptions();
  }
}
function pageStudio(){
  studioTab = studioTab || "looks";
  const a = MEM.avatar;
  document.getElementById("app").innerHTML = `<div class="avs-studio">
    <div class="avs-head">
      <div><h2>🎨 Avatar Studio</h2><p>Build Ahhk's look — saved forever, drives the assistant everywhere on this page.</p></div>
      <div class="avs-head-actions">
        <button type="button" class="avs-btn secondary" id="avs-random">🎲 Randomize</button>
        <button type="button" class="avs-btn primary" id="avs-save">💾 Save character</button>
      </div>
    </div>
    <div class="avs-shell">
      <aside class="avs-side">${AV_TABS.map(([v,l,s]) => `<button type="button" class="avs-tab${studioTab===v?" active":""}" data-tab="${v}"><span class="avs-symbol">${s}</span><span>${l}</span></button>`).join("")}</aside>
      <section class="avs-preview">
        <div class="avs-stage" id="avs-stage"></div>
        <div class="avs-preview-bar">
          <input type="text" id="avs-name" maxlength="48" value="${a.name.replace(/"/g,"&quot;")}" placeholder="Character name">
          <button type="button" class="avs-btn secondary" id="avs-export-svg">⬇ SVG</button>
          <button type="button" class="avs-btn secondary" id="avs-export-png">⬇ PNG</button>
          <button type="button" class="avs-btn secondary" id="avs-export-json">⬇ JSON</button>
          <label class="avs-btn secondary" for="avs-import-json" style="cursor:pointer">⬆ Import</label>
          <input type="file" id="avs-import-json" accept=".json,application/json" hidden>
        </div>
      </section>
      <section class="avs-panel"><div class="avs-options" id="avs-options"></div></section>
    </div>
  </div>`;
  document.getElementById("avs-options").innerHTML = studioOptions();
  studioPreview();
  /* bindings */
  const opts = document.getElementById("avs-options");
  opts.addEventListener("click", e => {
    const b = e.target.closest("[data-k]"); if(b){ avPatch(b.dataset.k, b.dataset.v); return; }
    const ld = e.target.closest("[data-load]"); if(ld){ MEM.avatar = validAvatar(MEM.avatarLib[+ld.dataset.load]); applyAvatar(); pageStudio(); charSay("Loaded " + MEM.avatar.name + " ✨", 2600); return; }
    const del = e.target.closest("[data-del]"); if(del){ MEM.avatarLib.splice(+del.dataset.del,1); saveMem(); document.getElementById("avs-options").innerHTML = studioOptions(); return; }
    if(e.target.closest("#avs-match-page")){
      const hex = cssHex("--accent"); if(hex) avPatch("accentColor", hex);
      charSay("Synced to the page theme 🎨", 2400);
    }
  });
  opts.addEventListener("input", e => {
    const el = e.target.closest("[data-k]"); if(!el) return;
    if(el.type === "range" || el.type === "color") avPatch(el.dataset.k, el.value);
  });
  document.querySelectorAll(".avs-tab").forEach(t => t.addEventListener("click", () => {
    studioTab = t.dataset.tab;
    document.querySelectorAll(".avs-tab").forEach(x => x.classList.toggle("active", x===t));
    opts.innerHTML = studioOptions();
  }));
  const nameInput = document.getElementById("avs-name");
  nameInput.addEventListener("change", () => {
    MEM.avatar.name = nameInput.value.trim().slice(0,48) || "Ahhk";
    applyAvatar(); charSay("Call me " + MEM.avatar.name + " 😎", 2600);
  });
  document.getElementById("avs-random").addEventListener("click", () => {
    const pick = l => l[Math.floor(Math.random()*l.length)][0];
    const pickC = l => l[Math.floor(Math.random()*l.length)];
    MEM.avatar = validAvatar({name:MEM.avatar.name, head:pick(AV_HEADS), expression:pick(AV_EXPR), eyes:pick(AV_EYES),
      eyeSize:75+Math.floor(Math.random()*11)*5, headSize:75+Math.floor(Math.random()*11)*5,
      body:pick(AV_BODIES), outfit:pick(AV_OUTFITS), accessory:pick(AV_ACC),
      shellColor:pickC(AV_SHELLS), accentColor:pickC(AV_ACCENTS),
      visorColor:pickC(["#080f24","#140b26","#06231f","#230b13","#10261b","#231d08","#0a1a2b","#1d0b26"]),
      finish:pick(AV_FINISH), background:MEM.avatar.background, personality:pick(AV_PERS), motion:pick(AV_MOTIONS)});
    applyAvatar(); pageStudio(); charSay("New random build! 🎲", 2400);
  });
  document.getElementById("avs-save").addEventListener("click", () => {
    const lib = MEM.avatarLib || (MEM.avatarLib = []);
    const copy = Object.assign({}, MEM.avatar, {id:Date.now().toString(36)+Math.random().toString(36).slice(2,8)});
    const dupe = lib.findIndex(c => c.name === copy.name);
    if(dupe >= 0) lib[dupe] = copy; else lib.unshift(copy);
    MEM.avatarLib = lib.slice(0,20); saveMem();
    charSay("Banked in my memory vault 💾 (" + MEM.avatarLib.length + "/20)", 2800);
  });
  const dl = (blob, name) => { const a2=document.createElement("a"); a2.href=URL.createObjectURL(blob); a2.download=name; a2.click(); setTimeout(()=>URL.revokeObjectURL(a2.href),4000); };
  const cleanSVG = w => avatarSVG(Object.assign({}, MEM.avatar), MEM.avatar.motion, null, w);
  document.getElementById("avs-export-svg").addEventListener("click", () => {
    dl(new Blob([cleanSVG(1000)],{type:"image/svg+xml"}), "ahhk-avatar.svg"); charSay("SVG exported ⬇", 2200);
  });
  document.getElementById("avs-export-png").addEventListener("click", () => {
    const url = URL.createObjectURL(new Blob([cleanSVG(1000)],{type:"image/svg+xml"}));
    const im = new Image();
    im.onload = () => {
      const c = document.createElement("canvas"); c.width=1000; c.height=1200;
      c.getContext("2d").drawImage(im,0,0,1000,1200);
      c.toBlob(b => { dl(b,"ahhk-avatar.png"); charSay("PNG exported ⬇", 2200); URL.revokeObjectURL(url); }, "image/png");
    };
    im.src = url;
  });
  document.getElementById("avs-export-json").addEventListener("click", () => {
    dl(new Blob([JSON.stringify(MEM.avatar,null,2)],{type:"application/json"}), "ahhk-avatar.json"); charSay("JSON config exported ⬇", 2200);
  });
  document.getElementById("avs-import-json").addEventListener("change", e => {
    const file = e.target.files[0]; if(!file) return;
    const rd = new FileReader();
    rd.onload = () => { try{ MEM.avatar = validAvatar(JSON.parse(rd.result)); applyAvatar(); pageStudio(); charSay("Imported! ✨", 2400); }catch{ charSay("That file isn't a valid avatar config 😕", 2800); } };
    rd.readAsText(file);
  });
}
function cssHex(varName){
  const t = document.createElement("div"); t.style.color = `var(${varName})`;
  document.body.appendChild(t); const c = getComputedStyle(t).color; t.remove();
  const m = c.match(/\d+/g); if(!m) return null;
  return "#" + m.slice(0,3).map(v => (+v).toString(16).padStart(2,"0")).join("");
}



/* first-boot migration: carry old customization forward into the avatar config */
if(!MEM.avatar){
  MEM.avatar = Object.assign({}, AV_DEFAULT,
    {name:(MEM.custom && MEM.custom.botName) || "Ahhk"});
  if(MEM.custom && MEM.custom.hat==="👑") MEM.avatar.accessory = "crown";
  if(MEM.custom && MEM.custom.faceg==="🕶️") MEM.avatar.accessory = "glasses";
  if(MEM.custom && MEM.custom.faceg==="🥽") MEM.avatar.accessory = "headphones";
}
MEM.custom = Object.assign({size:"m", energy:"normal"}, MEM.custom || {});
applyAvatar(); // dress the bot before first paint
route(); // first paint (learned + photo-matched + styled)
</script>
