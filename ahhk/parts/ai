/* dwell-based theme learning */
let hueStart = Date.now();
function recordDwell(){
  if(MEM.lastHue === null) return;
  const sec = Math.round((Date.now() - hueStart)/1000);
  MEM.dwell[MEM.lastHue] = (MEM.dwell[MEM.lastHue]||0) + sec;
  hueStart = Date.now();
}
function learnedHue(){
  recordDwell();
  const keys = Object.keys(MEM.dwell);
  if(keys.length && Math.random() < .55){ // 55%: bias toward hues you lingered on
    const top = keys.sort((a,b)=>MEM.dwell[b]-MEM.dwell[a])[0];
    return (parseInt(top) + Math.floor(Math.random()*50) - 25 + 360) % 360;
  }
  return Math.floor(Math.random()*360);
}
window.addEventListener("beforeunload", ()=>{ recordDwell(); saveMem(); });

