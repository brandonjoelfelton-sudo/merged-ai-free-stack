.avs-btn{border-radius:10px;padding:9px 14px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid rgba(255,255,255,.14);transition:all .15s}
.avs-btn.primary{background:linear-gradient(135deg,#4d7dff,#8a5cf6);color:#fff;border-color:transparent}
.avs-btn.primary:hover{filter:brightness(1.15)}
.avs-btn.secondary{background:rgba(255,255,255,.07);color:#d7def5}
.avs-btn.secondary:hover{background:rgba(255,255,255,.13)}
.avs-panel{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:16px;max-height:560px;overflow-y:auto}
.avs-section{margin-bottom:20px}
.avs-section h3{margin:0 0 9px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#8b96bb}
