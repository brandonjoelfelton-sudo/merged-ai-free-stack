burns{from{transform:scale(1) translate(0,0)}to{transform:scale(1.14) translate(-1.8%,-2.2%)}}
.photo-veil{position:fixed; inset:0; z-index:1; pointer-events:none;
  background:linear-gradient(var(--angle,135deg),
    hsla(var(--hue),60%,10%,.5), hsla(var(--hue2),55%,8%,.62));
  transition:background 1.2s ease}
/* ── AHHK CHARACTER ─────────────────────────────────── */
.char{position:fixed; left:28px; bottom:26px; z-index:60; cursor:pointer; user-select:none;
  transition:left 2.2s ease-in-out}
.char-face{font-size:56px; display:inline-block; filter:drop-shadow(0 6px 14px rgba(0,0,0,.5));
  animation:bob 3.5s ease-in-out infinite; transition:transform .4s}
.char-shadow{width:46px; height:8px; background:rgba(0,0,0,.35); border-radius:50%; margin:2px auto 0; filter:blur(3px)}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-7px)}}
.char.think .char-face{animation:tilt 1.2s ease-in-out infinite}
@keyframes tilt{0%,100%{transform:rotate(-9deg) scale(1.02)}50%{transform:rotate(9deg) scale(1.02)}}
.char.yawn .char-face{animation:yawnA 2.4s ease-in-out infinite}
@keyframes yawnA{0%,100%{transform:scale(1)}45%{transform:scale(1.18,1.3)}}
.char.sleep .char-face{animation:sleepA 4.5s ease-in-out infinite; opacity:.8}
@keyframes sleepA{0%,100%{transform:rotate(-14deg) translateY(3px)}50%{transform:rotate(-10deg) translateY(0)}}
.char.wave .char-face{animation:waveA .9s ease-in-out 3}
@keyframes waveA{0%,100%{transform:rotate(0)}25%{transform:rotate(-20deg)}75%{transform:rotate(15deg)}}
.char.hop .char-face{animation:hopA .55s ease-out 2}
@keyframes hopA{0%,100%{transform:translateY(0)}40%{transform:translateY(-22px)}}
.char-bubble{position:absolute; bottom:calc(100% + 12px); left:0; width:max-content; max-width:250px;
  background:var(--bg2); border:1px solid var(--card-line); padding:10px 14px; font-size:.8rem;
  line-height:1.5; opacity:0; transform:translateY(8px); transition:.35s; pointer-events:none;
  font-family:var(--font-body); color:var(--ink)}
.char-bubble.show{opacity:1; transform:translateY(0)}
.char-bubble::after{content:""; position:absolute; top:100%; left:26px;
  border:7px solid transparent; border-top-color:var(--card-line)}
.heart{background:none; border:1px solid var(--card-line); color:var(--ink); margin-top:14px;
  padding:4px 12px; cursor:pointer; font-size:.8rem; transition:.3s; opacity:.7}
.heart:hover,.heart.on{color:var(--accent); border-color:var(--accent); opacity:1}
/* ── AHHK BOT BODY (image mascot, theme-reactive) ───── */
.char-body{position:relative; font-size:var(--csz,96px); animation:bob var(--bobspeed,3.5s) ease-in-out infinite;
  transition:transform .4s; transform-origin:50% 80%}
.char-img{width:1em; height:auto; display:block;
  filter:hue-rotate(var(--charrot,0deg)) saturate(var(--charsat,1.15)) drop-shadow(0 10px 22px rgba(0,0,0,.55));
  transition:filter 1.2s ease}
.char.think .char-face{animation:none}
.char.think .char-body{animation:tilt 1.2s ease-in-out infinite}
.char.yawn .char-body{animation:yawnA 2.4s ease-in-out infinite}
.char.sleep .char-body{animation:sleepA 4.5s ease-in-out infinite; opacity:.75}
.char.wave .char-body{animation:waveA .9s ease-in-out 3}
.char.hop .char-body{animation:hopA .55s ease-out 2}
.char-mood{position:absolute; right:-.08em; bottom:.02em; font-size:.3em; line-height:1;
  background:var(--bg2); border:1px solid var(--card-line); border-radius:50%; padding:.12em;
  min-width:1em; text-align:center}
.char-mood:empty{display:none}
.char-hat{position:absolute; top:-.2em; left:50%; transform:translateX(-50%) rotate(-10deg);
  font-size:.46em; z-index:2; pointer-events:none}
.char-hat:empty{display:none}
.char-glasses{position:absolute; top:.26em; left:50%; transform:translateX(-50%);
  font-size:.38em; z-index:2; pointer-events:none}
.char-glasses:empty{display:none}
.char-gear{position:absolute; top:-8px; right:-14px; z-index:3; background:var(--bg2);
  border:1px solid var(--card-line); color:var(--ink); border-radius:50%; width:26px; height:26px;
  cursor:pointer; font-size:.75rem; opacity:0; transition:.3s}
.char:hover .char-gear{opacity:.9}
/* ── CUSTOMIZATION PANEL (Bitmoji-style) ────────────── */
.custom-panel{position:fixed; left:28px; bottom:180px; z-index:70; width:min(320px, calc(100vw - 48px));
  background:var(--bg2); border:1px solid var(--card-line); box-shadow:0 20px 60px rgba(0,0,0,.55);
  padding:18px; display:none; font-family:var(--font-body)}
.custom-panel.open{display:block}
.cp-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:8px}
.cp-head b{font-family:var(--font-display); letter-spacing:.25em; color:var(--accent); font-size:.9rem}
.cp-head button{background:none; border:none; color:var(--ink); cursor:pointer; opacity:.7; font-size:1rem}
.cp-sec{font-size:.62rem; letter-spacing:.25em; text-transform:uppercase; color:var(--accent2); margin:14px 0 8px}
.cp-row{display:flex; gap:8px; flex-wrap:wrap}
.cp-row button{background:var(--card-bg); border:1px solid var(--card-line); color:var(--ink);
  padding:7px 12px; cursor:pointer; font-size:.8rem; transition:.25s}
.cp-row button:hover{border-color:var(--accent)}
.cp-row button.sel{background:var(--accent); color:var(--bg1); border-color:var(--accent)}
.cp-row button.sw{width:34px; height:34px; padding:0; border-radius:50%}
.cp-row button.sw.sel{outline:2px solid var(--ink); outline-offset:2px}
.cp-row input{flex:1; background:var(--card-bg); border:1px solid var(--card-line); color:var(--ink);
  padding:9px 12px; font-size:.9rem; outline:none; font-family:var(--font-body)}
.cp-note{margin-top:14px; font-size:.62rem; letter-spacing:.15em; text-transform:uppercase; opacity:.55}

/* ═══ Avatar Studio UI ═══ */
.avs-studio{max-width:1060px;margin:0 auto;background:rgba(10,12,24,.82);border:1px solid rgba(255,255,255,.1);border-radius:24px;padding:22px;backdrop-filter:blur(14px)}
.avs-head{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:18px}
.avs-head h2{margin:0 0 4px;font-size:22px;color:#eef2ff}
.avs-head p{margin:0;font-size:13px;color:#9aa6c8}
.avs-head-actions{display:flex;gap:10px}
.avs-shell{display:grid;grid-template-columns:170px minmax(280px,440px) 1fr;gap:18px}
.avs-side{display:flex;flex-direction:column;gap:6px}
.avs-tab{display:flex;align-items:center;gap:10px;padding:11px 13px;border-radius:12px;border:1px solid transparent;background:transparent;color:#aab4d4;font-size:14px;cursor:pointer;text-align:left;transition:all .15s}
.avs-tab:hover{background:rgba(255,255,255,.06)}
.avs-tab.active{background:rgba(90,140,255,.16);border-color:rgba(120,160,255,.35);color:#fff}
