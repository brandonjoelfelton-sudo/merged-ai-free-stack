.avs-stage{background:repeating-conic-gradient(rgba(255,255,255,.05) 0 25%,transparent 0 50%) 0 0/28px 28px,#0b0e1c;border:1px solid rgba(255,255,255,.1);border-radius:18px;min-height:380px;display:flex;align-items:center;justify-content:center;padding:12px}
.avs-stage svg{max-height:420px;width:auto;max-width:100%}
.avs-preview-bar{display:flex;gap:8px;flex-wrap:wrap}
