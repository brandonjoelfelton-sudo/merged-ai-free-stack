askerville',serif","'Work Sans',sans-serif"],
 ["'Bebas Neue',sans-serif","'Inter',sans-serif"]
];
const LAYOUTS = ["left","center","split"];
function rollTheme(){
  const hue = Math.floor(Math.random()*360);
  const hue2 = (hue + 40 + Math.floor(Math.random()*120)) % 360;
  const dark = Math.random() > .25; // mostly dark, sometimes light
  const r = document.documentElement.style;
  r.setProperty("--hue", hue); r.setProperty("--hue2", hue2);
  r.setProperty("--angle", Math.floor(Math.random()*360)+"deg");
  r.setProperty("--gx1", Math.floor(Math.random()*80)+"%");
  r.setProperty("--gy1", Math.floor(Math.random()*60)+"%");
  r.setProperty("--gx2", 20+Math.floor(Math.random()*80)+"%");
  r.setProperty("--gy2", 40+Math.floor(Math.random()*60)+"%");
  if(dark){
    r.setProperty("--bg1", `hsl(${hue}, 24%, ${6+Math.random()*6}%)`);
    r.setProperty("--bg2", `hsl(${hue2}, 26%, ${10+Math.random()*8}%)`);
    r.setProperty("--ink", `hsl(${hue}, 20%, 94%)`);
    r.setProperty("--accent", `hsl(${(hue+180)%360}, 75%, 62%)`);
    r.setProperty("--accent2", `hsl(${hue2}, 65%, 68%)`);
    r.setProperty("--card-bg", "rgba(255,255,255,.04)");
    r.setProperty("--card-line", "rgba(255,255,255,.12%)");
  }else{
    r.setProperty("--bg1", `hsl(${hue}, 40%, 93%)`);
    r.setProperty("--bg2", `hsl(${hue2}, 38%, 88%)`);
    r.setProperty("--ink", `hsl(${hue}, 30%, 12%)`);
    r.setProperty("--accent", `hsl(${(hue+180)%360}, 70%, 40%)`);
    r.setProperty("--accent2", `hsl(${hue2}, 55%, 35%)`);
    r.setProperty("--card-bg", "rgba(255,255,255,.5)");
    r.setProperty("--card-line", "rgba(0,0,0,.12)");
  }
  const pair = FONTS[Math.floor(Math.random()*FONTS.length)];
  loadFonts(pair);
  r.setProperty("--font-display", pair[0]);
  r.setProperty("--font-body", pair[1]);
  return {layout: LAYOUTS[Math.floor(Math.random()*LAYOUTS.length)]};
}
function loadFonts(pair){
  const fams = [...new Set(pair.map(f=>f.split(",")[0].replace(/'/g,"").trim()))];
  const q = fams.map(f=>"family="+f.replace(/ /g,"+")+":ital,wght@0,400;0,700;1,400").join("&");
  let link = document.getElementById("gfonts");
  if(!link){ link=document.createElement("link"); link.id="gfonts"; link.rel="stylesheet"; document.head.appendChild(link); }
  link.href = "https://fonts.googleapis.com/css2?"+q+"&display=swap";
}

/* ══════════ QUOTE RIVER (background) ══════════ */
function buildRiver(){
  const river = document.getElementById("river");
  river.innerHTML = "";
  const rows = 7, pool = shuffle(QUOTES);
  for(let i=0;i<rows;i++){
    const row = document.createElement("div");
    row.className = "river-row";
    const chunk = pool.slice(i*5, i*5+5).map(q=>`<span>“${q.t}” <b>— ${q.a}</b></span>`).join("");
    row.innerHTML = chunk + chunk; // seamless loop
    const dur = 60 + Math.random()*80;
    row.style.animation = `${i%2? "driftR":"driftL"} ${dur}s linear infinite`;
    row.style.transform = `translateY(${i*14}vh)`;
    river.appendChild(row);
  }
}

