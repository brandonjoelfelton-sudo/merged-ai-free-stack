  }else if(nm && !new RegExp(MEM.name,"i").test(reply)){
    reply = `Got it, ${MEM.name} — stored in permanent memory.\n\n` + reply;
  }
  history.push({role:"assistant", content:reply});
  MEM.chat.push({t:Date.now(), you:text, ahhk:reply}); saveMem();
  if(thinking) thinking.innerHTML = `<span class="who">Ahhk</span>${reply.replace(/</g,"&lt;").replace(/\n/g,"<br>")}`;
